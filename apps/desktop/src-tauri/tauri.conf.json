{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Livariant",
  "version": "0.1.0-rc.28",
  "identifier": "dev.livariant.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420",
        "font-src": "'self' data:",
        "img-src": "'self' blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' 'unsafe-eval'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'"
      }
    },
    "windows": [
      {
        "title": "Livariant",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 480,
        "preventOverflow": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "windowEffects": {
          "effects": ["acrylic"]
        }
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "DeveloperTool",
    "shortDescription": "Living software framework desktop foundation",
    "longDescription": "Livariant Desktop provides the normal-user surface for installation health, Guardian readiness, projects, First Steps, updates, settings and diagnostics.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "windows/branding/installer-header.bmp",
        "uninstallerHeaderImage": "windows/branding/installer-header.bmp",
        "sidebarImage": "windows/branding/installer-sidebar.bmp",
        "languages": ["German", "English"],
        "displayLanguageSelector": true,
        "installerHooks": "./windows/language-hooks.nsh",
        "startMenuFolder": "Livariant"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyNUJCNUJFNUNDNjc3QQpSV1I2Wjh6bFc3c2xBWnJSSFNndThoeEhoS1FubFlFU1VDSHlhNWVQS3kyZWZkZE9EYTd0eGIyaAo=",
      "endpoints": [
        "https://raw.githubusercontent.com/Kryt3r/livariant/desktop-preview-index/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
