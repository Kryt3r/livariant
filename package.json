{
  "name": "livariant",
  "version": "0.1.0-rc.6",
  "private": true,
  "description": "Livariant 0.1.0 release-candidate baseline for Public Preview.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "files": [
    "dist/src"
  ],
  "bin": {
    "livariant": "./dist/src/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js && npm run test:release-dossier && npm run test:verification-trace-benchmark",
    "test:package": "node scripts/package-smoke.mjs && node scripts/mcp-package-smoke.mjs && node scripts/discovery-package-smoke.mjs && node scripts/first-run-package-smoke.mjs",
    "test:release-bundle": "node scripts/release-bundle-smoke.mjs",
    "test:release-dossier": "node --test scripts/release-decision-dossier.test.mjs",
    "test:verification-trace-benchmark": "node --test scripts/verification-trace-token-benchmark.test.mjs",
    "test:public-docs": "node scripts/check-public-doc-consistency.mjs",
    "benchmark:tokens": "npm run build && node scripts/token-efficiency-baseline.mjs",
    "benchmark:verification-trace": "npm run build && node scripts/verification-trace-token-benchmark.mjs",
    "release:bundle": "node scripts/build-release-bundle.mjs",
    "release:dossier": "node scripts/build-release-decision-dossier.mjs",
    "prepack": "npm run build",
    "dev": "npm run build && node dist/src/cli/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
